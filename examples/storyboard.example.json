  "subtitles": [
    { "id": "s01", "start": 19.9, "end": 26.5, "cn": "把一封信，交给潮汐。", "en": "I gave a letter to the tide.", "position": "bottom" },
    { "id": "s02", "start": 32.2, "end": 38.8, "cn": "它替我，去看你。", "en": "It went to see you, for me.", "position": "bottom" },
    { "id": "s03", "start": 45.0, "end": 51.5, "cn": "纸很轻，思念很重。", "en": "Paper is light; longing is heavy.", "position": "bottom" },
    { "id": "s04", "start": 61.4, "end": 68.0, "cn": "月亮是唯一的地址。", "en": "The moon is the only address I know.", "position": "bottom" },
    { "id": "s05", "start": 104.8, "end": 109.7, "cn": "有些话，停在呼吸里。", "en": "Some words stop at the breath.", "position": "bottom" },
    { "id": "s06", "start": 111.2, "end": 118.5, "cn": "我在每一个倒影里，练习说爱你。", "en": "In every reflection, I practice love.", "position": "bottom" },
    { "id": "s07", "start": 145.0, "end": 151.8, "cn": "雨落在相反的方向。", "en": "The rain falls the other way.", "position": "bottom" },
    { "id": "s08", "start": 165.0, "end": 171.8, "cn": "所有的字，都朝你生长。", "en": "Every word grows toward you.", "position": "bottom" },
    { "id": "s09", "start": 181.0, "end": 187.8, "cn": "于是我，向更深处坠落。", "en": "So I let myself fall deeper.", "position": "bottom" },
    { "id": "s10", "start": 196.0, "end": 203.0, "cn": "在光抵达之前，我先成为光。", "en": "Before the light arrives, I become it.", "position": "bottom" },
    { "id": "s11", "start": 224.8, "end": 231.4, "cn": "穿过月亮，就能抵达你吗？", "en": "If I cross the moon, will I reach you?", "position": "bottom" },
    { "id": "s12", "start": 242.0, "end": 249.0, "cn": "我终于明白，爱不是抵达。", "en": "I finally learned: love is not arrival.", "position": "bottom" },
    { "id": "s13", "start": 261.2, "end": 268.4, "cn": "它是让一封信，走了很远很远。", "en": "It is letting a letter travel very, very far.", "position": "bottom" },
    { "id": "s14", "start": 282.0, "end": 289.2, "cn": "我爱你。", "en": "I love you.", "position": "bottom" },
    { "id": "s15", "start": 294.8, "end": 299.6, "cn": "写给没有寄出的那封信。", "en": "For the letter that was never sent.", "position": "bottom" }
  ],
  "notes": "Subtitle lines are original poetic intertitles, not the copyrighted lyrics. Audio is not included in this repository."
}
