{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mvcraft.dev/schemas/art-direction.schema.json",
  "title": "mvcraft art direction",
  "type": "object",
  "required": ["style", "palette", "materials", "forbidden", "light", "lens", "type", "post", "transitions"],
  "properties": {
    "style": { "type": "string", "minLength": 1 },
    "palette": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "forbidden": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "light": {
      "type": "object",
      "required": ["direction", "kelvin", "contrast"],
      "properties": {
        "direction": { "type": "string", "examples": ["top", "side", "back", "front", "window-left"] },
        "kelvin": { "type": "number", "minimum": 1000, "maximum": 20000 },
        "contrast": { "type": "number", "minimum": 0, "maximum": 1 },
        "volumetric": { "type": "boolean" }
      }
    },
    "lens": {
      "type": "object",
      "required": ["focal", "shake"],
      "properties": {
        "focal": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number", "exclusiveMinimum": 0 }
        },
        "shake": { "type": "number", "minimum": 0, "maximum": 0.2 },
        "maxRoll": { "type": "number", "minimum": 0, "maximum": 0.5 }
      }
    },
    "type": {
      "type": "object",
      "required": ["cjk", "latin"],
      "properties": {
        "cjk": { "type": "string" },
        "latin": { "type": "string" },
        "weights": {
          "type": "array",
          "items": { "type": "integer", "minimum": 100, "maximum": 900 }
        },
        "tracking": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "post": {
      "type": "object",
      "required": ["bloom", "grain", "vignette", "toneMapping"],
      "properties": {
        "bloom": { "type": "number", "minimum": 0, "maximum": 2 },
        "bloomThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "grain": { "type": "number", "minimum": 0, "maximum": 0.2 },
        "vignette": { "type": "number", "minimum": 0, "maximum": 1 },
        "aberration": { "type": "number", "minimum": 0, "maximum": 0.02 },
        "toneMapping": { "type": "string", "enum": ["ACES", "AgX", "Reinhard", "None"] }
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["cut", "fade", "dip", "ink", "dissolve", "iris", "flash", "match"]
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "note": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "field", "reason"],
        "properties": {
          "date": { "type": "string" },
          "field": { "type": "string" },
          "from": {},
          "to": {},
          "reason": { "type": "string" }
        }
      }
    }
  }
}
