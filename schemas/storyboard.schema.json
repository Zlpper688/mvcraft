{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mvcraft.dev/schemas/storyboard.schema.json",
  "title": "mvcraft storyboard",
  "type": "object",
  "required": ["title", "duration", "fps", "shots"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "titleEn": { "type": "string" },
    "duration": { "type": "number", "exclusiveMinimum": 0 },
    "fps": { "type": "number", "exclusiveMinimum": 0 },
    "aspect": { "type": "string", "examples": ["2.39:1", "16:9", "9:16"] },
    "style": { "type": "string" },
    "audio": {
      "type": "object",
      "properties": {
        "file": { "type": "string" },
        "bpm": { "type": "number", "exclusiveMinimum": 0 },
        "loudnessTarget": { "type": "number" }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "start", "end", "energy"],
        "properties": {
          "name": { "type": "string" },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "minimum": 0 },
          "energy": { "type": "number", "minimum": 0, "maximum": 1 },
          "function": {
            "type": "string",
            "enum": ["intro", "verse", "pre-chorus", "chorus", "bridge", "drop", "outro"]
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/shot" }
    },
    "subtitles": {
      "type": "array",
      "items": { "$ref": "#/$defs/subtitle" }
    },
    "notes": { "type": "string" }
  },
  "$defs": {
    "shot": {
      "type": "object",
      "required": ["id", "start", "end", "scene", "function", "subject", "event", "transitionIn"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "exclusiveMinimum": 0 },
        "scene": { "type": "string" },
        "view": { "type": "string" },
        "name": { "type": "string" },
        "nameEn": { "type": "string" },
        "function": {
          "type": "string",
          "enum": ["establish", "follow", "detail", "macro", "insert", "reaction", "transition", "breathe", "impact", "title"]
        },
        "shot": { "type": "string" },
        "subject": { "type": "string" },
        "event": { "type": "string" },
        "entry": { "type": "string" },
        "exit": { "type": "string" },
        "direction": {
          "type": "string",
          "enum": ["left", "right", "up", "down", "in", "out", "static"]
        },
        "beat": { "type": "string" },
        "still": { "type": "boolean" },
        "transitionIn": { "$ref": "#/$defs/transition" },
        "subtitle": { "type": ["string", "null"] },
        "qa": {
          "type": "object",
          "properties": {
            "subjectScreenArea": { "type": "number", "minimum": 0, "maximum": 1 },
            "maxMotion": { "type": "number", "minimum": 0 },
            "minLuma": { "type": "number", "minimum": 0, "maximum": 1 },
            "priority": { "type": "string", "enum": ["low", "normal", "high"] }
          }
        }
      }
    },
    "transition": {
      "type": "object",
      "required": ["type", "duration"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["cut", "fade", "dip", "ink", "dissolve", "iris", "flash", "match"]
        },
        "duration": { "type": "number", "minimum": 0, "maximum": 4 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    },
    "subtitle": {
      "type": "object",
      "required": ["start", "end", "cn"],
      "properties": {
        "id": { "type": "string" },
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "minimum": 0 },
        "cn": { "type": "string", "minLength": 1 },
        "en": { "type": "string" },
        "position": { "type": "string", "enum": ["bottom", "top", "left", "right", "center"] },
        "plate": { "type": "boolean" }
      }
    }
  }
}
